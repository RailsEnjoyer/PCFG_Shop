<header class="header site-header">
  <div class="site-shell">
    <nav class="nav site-nav" aria-label="Primary navigation" data-site-nav>
      <div class="site-nav__brand">
        <%= link_to 'PCFG', root_path, class: 'logo site-logo' %>
        <p class="site-nav__tagline">Custom PC builds in one click</p>
      </div>

      <div class="site-nav__panel" id="site-navigation-panel" data-site-nav-panel>
        <div class="site-nav__center">
          <%= render 'layouts/primary_navigation' %>
        </div>

        <div class="menu__login site-user-nav">
          <% if current_user.present? %>
            <%= link_to "@#{current_user.nickname}", user_path(current_user), class: 'menu__link site-user-nav__profile' %>
            <%= button_to 'Exit', session_path, method: :delete, class: 'btn-exit site-user-nav__button' %>
          <% else %>
            <%= link_to 'Sign up', new_user_path, class: 'menu__link' %>
            <%= link_to 'Log in', new_session_path, class: 'menu__link' %>
          <% end %>
        </div>
      </div>

      <div class="site-nav__controls">
        <%= link_to cart_path, class: 'basket site-icon-link', aria: { label: 'Open cart' } do %>
          <%= image_tag('logos/cart.png', height: '30px', width: '30px', alt: 'cart') %>
        <% end %>

        <button
          class="site-nav__toggle"
          type="button"
          data-site-nav-toggle
          aria-controls="site-navigation-panel"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="site-nav__toggle-line"></span>
          <span class="site-nav__toggle-line"></span>
          <span class="site-nav__toggle-line"></span>
        </button>
      </div>
    </nav>
  </div>

  <button id="scroll-up-arrow" class="scroll-up-arrow" type="button" aria-label="Scroll to top">
    <%= image_tag('swiper/up.png', alt: '', width: 18, height: 18) %>
  </button>
</header>
