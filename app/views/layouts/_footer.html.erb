<footer class="footer site-footer">
  <div class="site-shell site-footer__shell">
    <div class="site-footer__brand">
      <%= link_to 'PCFG', root_path, class: 'logo site-logo' %>
      <p class="site-footer__text">
        A gaming-first configurator and storefront flow for testing build ideas with less noise and a cleaner visual
        path.
      </p>
    </div>

    <div class="site-footer__columns">
      <div class="site-footer__column">
        <p class="site-footer__heading">Navigate</p>
        <%= render 'layouts/primary_navigation', extra_class: 'primary-nav--footer' %>
      </div>

      <div class="site-footer__column">
        <p class="site-footer__heading">Contact</p>
        <%= mail_to 'pcfgshop@gmail.com', 'pcfgshop@gmail.com', class: 'site-footer__mail' %>
        <%= render 'layouts/social_navigation', extra_class: 'site-social--footer' %>
      </div>
    </div>
  </div>

  <div class="site-shell site-footer__bottom">
    <p class="site-footer__legal">PCFG is a test storefront and configurator concept built as a Rails pet project.</p>
    <p class="site-footer__legal">Please contact via bahdan.davidovich@gmail.com if you have any questions.</p>
  </div>
</footer>
