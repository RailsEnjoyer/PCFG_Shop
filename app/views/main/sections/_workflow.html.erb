<section class="home-section home-section--workflow">
  <div class="container">
    <div class="home-workflow">
      <div class="home-workflow__intro">
        <p class="home-section__eyebrow">How it works now</p>
        <h2 class="home-section__title">A simple path from game idea to purchase-ready direction.</h2>
      </div>

      <div class="home-workflow__steps">
        <% home_page.workflow_steps.each do |step| %>
          <article class="home-step">
            <p class="home-step__number"><%= step.number %></p>
            <h3 class="home-step__title"><%= step.title %></h3>
            <p class="home-step__text"><%= step.description %></p>
          </article>
        <% end %>
      </div>
    </div>
  </div>
</section>
