    <%= render 'layouts/head' %>
    <%= stylesheet_link_tag('styles') %>
    <%= stylesheet_link_tag('home') %>
  </head>
  <body class="home-page">
    <%= render 'layouts/header' %>

    <main class="main home-main">
      <%= render 'main/sections/landing/hero', home_page: @home_page %>
